# Copy to .env to override defaults. Every value below is optional.

# Host ports exposed by Docker.
BACKEND_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# PostgreSQL container credentials / database.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=school_admission

# Full connection string used by the backend. Keep "Host=db" when running in Compose.
DATABASE_URL=Host=db;Port=5432;Database=school_admission;Username=postgres;Password=postgres

# Hold lifetime in seconds (default 600).
HOLD_DURATION_SECONDS=600

# URL the browser uses to call the backend (runtime-injected into the frontend).
API_BASE_URL=http://localhost:8080

# Browser origins allowed to call the backend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maintenance database used by the test container; tests create their own databases.
TEST_DATABASE_URL=Host=db;Port=5432;Database=postgres;Username=postgres;Password=postgres
