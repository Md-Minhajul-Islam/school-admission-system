FROM mcr.microsoft.com/dotnet/sdk:10.0 AS test

WORKDIR /src

COPY Directory.Build.props Directory.Packages.props SchoolAdmission.sln ./
COPY src/SchoolAdmission.Domain/SchoolAdmission.Domain.csproj src/SchoolAdmission.Domain/
COPY src/SchoolAdmission.Application/SchoolAdmission.Application.csproj src/SchoolAdmission.Application/
COPY src/SchoolAdmission.Infrastructure/SchoolAdmission.Infrastructure.csproj src/SchoolAdmission.Infrastructure/
COPY src/SchoolAdmission.Api/SchoolAdmission.Api.csproj src/SchoolAdmission.Api/
COPY tests/SchoolAdmission.Application.UnitTests/SchoolAdmission.Application.UnitTests.csproj tests/SchoolAdmission.Application.UnitTests/
COPY tests/SchoolAdmission.Api.IntegrationTests/SchoolAdmission.Api.IntegrationTests.csproj tests/SchoolAdmission.Api.IntegrationTests/

RUN dotnet restore SchoolAdmission.sln

COPY . .

ENV TEST_DATABASE_URL="Host=db;Port=5432;Database=postgres;Username=postgres;Password=postgres"

ENTRYPOINT ["dotnet", "test", "SchoolAdmission.sln", "--no-restore", "--logger", "console;verbosity=normal"]
